# Copiez ce fichier en « .env » pour tester sur votre ordinateur (npm run dev).
# Sur Netlify, ces valeurs se mettent dans : Project configuration → Environment variables.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
# Supabase → Project Settings → API → clé « anon public » (publique, sans danger dans le navigateur)
VITE_SUPABASE_ANON_KEY=VOTRE_CLE_ANON

# Clé MapTiler (déjà utilisée pour la carte de la zone) — sert aussi à situer les adresses dans l'espace apiculteur
VITE_MAPTILER_KEY=BWLQgt3asW0Wt5A6AKvg

# Réservé aux fonctions Netlify (gestion de l'équipe). NE JAMAIS préfixer par VITE_ :
# SUPABASE_URL=https://VOTRE-PROJET.supabase.co
# SUPABASE_ANON_KEY=VOTRE_CLE_ANON
# SUPABASE_SERVICE_ROLE_KEY=VOTRE_CLE_SERVICE_ROLE   (secrète !)
